use "layout.hypra"

page(layout: Site, title: "Guides", canonical: "https://hypralang.dev/guides/", description: "Step-by-step guides: Markdown for AI agents in Node.js and Laravel, llms.txt, WebMCP tools and accessibility checks.") {
  props(guides: List)

  div(class: "mx-auto max-w-6xl px-6 pt-14") {
    h1(class: "text-[2.6rem] leading-tight font-extrabold tracking-[-0.025em]") "Guides"
    p(class: "mt-3 max-w-2xl text-lg text-ink-2") "Each guide solves one problem: first the way you'd do it today, then with Hypra, with the real output."
    ul(class: "mt-10 grid gap-px border-y border-rule bg-rule sm:grid-cols-3") {
      for guide in guides {
        li(class: "bg-paper") {
          a(guide.url, class: "block h-full p-6 no-underline hover:bg-code") {
            h2(class: "text-xl leading-snug font-bold") {
              if guide.extra { span(class: "text-pass", aria-hidden: true) "→ " }
              "{guide.title}"
            }
            p(class: "mt-2 text-ink-2") "{guide.description}"
          }
        }
      }
    }
  }
}
