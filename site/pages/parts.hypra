// The Hypra mark: an H with a green square, the compiler's "this passes".
component Mark() {
  svg(viewBox: "0 0 32 32", aria-hidden: true) {
    rect(width: 32, height: 32, rx: 6, class: "fill-ink")
    path(d: "M10 8v16M22 8v16M10 16h12", class: "stroke-paper", stroke-width: 3.4, stroke-linecap: "square", fill: "none")
    rect(x: 19.5, y: 20.5, width: 5, height: 5, class: "fill-pass")
  }
}

// A code block with its file name or format above it.
component Code(label: Text, note: Text = "") {
  figure(class: "min-w-0") {
    figcaption(class: "mb-2 flex items-baseline justify-between gap-4 text-[14px]") {
      span(class: "font-bold") "{label}"
      span(class: "font-mono text-mute") "{note}"
    }
    slot
  }
}

// One of the numbered sections of the landing page.
component Section(number: Text, title: Text) {
  section(class: "mx-auto mt-24 max-w-6xl px-6") {
    h2(class: "flex items-baseline gap-4 border-t-2 border-ink pt-5 text-[1.9rem] leading-tight") {
      span(class: "font-mono text-[1rem] font-normal text-mute") "{number}"
      "{title}"
    }
    slot
  }
}
