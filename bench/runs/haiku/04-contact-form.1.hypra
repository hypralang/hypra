page(title: "Contact us", description: "Send us a message about an order, a catering booking or anything else, and we will reply by email.") {
  h1 "Contact us"
  form("/contact", name: "contact", description: "Send a message to Crumb & Co") {
    field("name", type: String(1..80), label: "Name")
    field("email", type: Email, label: "Email")
    field("subject", type: Choice("order", "catering", "other"), label: "Subject")
    field("message", type: Text(max: 1000), label: "Message")
    field("privacy", type: Accept, label: "I accept the privacy policy")
    button "Send message"
  }
}
